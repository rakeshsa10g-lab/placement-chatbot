# Copy to .env for local testing (`npm run dev`).
# On Vercel, set these in Project Settings -> Environment Variables instead.
#
# Set ONE of the two API keys below. If both are set, Claude is used unless
# LLM_PROVIDER=gemini forces Gemini.

# ---- Option A: completely free (Google Gemini free tier) ----
# Get a key at https://aistudio.google.com -> "Get API key". No credit card;
# hard daily caps mean you can never be billed. See README "Deploying completely free".
GEMINI_API_KEY=
# gemini-flash-lite-latest (default) has a much larger free quota — best for many students.
# gemini-flash-latest gives richer answers but only ~5 requests/minute on the free tier.
GEMINI_MODEL=gemini-flash-lite-latest

# ---- Option B: also free (Llama, via any OpenAI-compatible provider) ----
# Default is Groq (https://console.groq.com â€” free key, no credit card, very fast).
# Also works with OpenRouter, Together AI, or a self-hosted Ollama server:
#   Groq:       https://api.groq.com/openai/v1        model: llama-3.3-70b-versatile
#   OpenRouter: https://openrouter.ai/api/v1          model: meta-llama/llama-3.3-70b-instruct:free
#   Ollama:     http://localhost:11434/v1             model: llama3.3   (key can be any text)
LLAMA_API_KEY=
LLAMA_BASE_URL=https://api.groq.com/openai/v1
LLAMA_MODEL=llama-3.3-70b-versatile

# ---- Option C: best quality (Anthropic Claude, pay-per-use) ----
# Create at https://platform.claude.com (API Keys). ~$0.006-0.03 per question.
ANTHROPIC_API_KEY=
# Optional: claude-opus-4-8 (default, best) or claude-haiku-4-5 (~5x cheaper)
ANTHROPIC_MODEL=claude-opus-4-8

# Force a provider when several keys are set: anthropic | gemini | llama
# LLM_PROVIDER=gemini

# Shown to students in the bot's persona
INSTITUTION_NAME=IIT Madras

# Lock the API to your website's origin once embedded, e.g. https://placements.example.edu
# Leave as * while testing.
ALLOWED_ORIGIN=*

